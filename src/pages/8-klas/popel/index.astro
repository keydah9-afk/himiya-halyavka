---
/*
  Друга книга сайту: «Хімія, 8 клас» П. Попеля, Л. Крикля (Академія, 2025).
  Пристрій той самий, що в Григоровича: обидва режими («Списати» / «Зрозуміти»),
  прогрес у localStorage, вся книга на одному URL. Нумерація вправ у цьому підручнику
  починається заново в кожному параграфі, тому id завдань містять номер параграфа.
  Тренажер задач тут поки не підключаємо: він потрібен лише з § 14 (кількість речовини).
*/
import Base from '~/layouts/Base.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import BookHero from '~/components/BookHero.astro';
import SolutionGallery from '~/components/SolutionGallery.astro';
import { SITE } from '~/data/site';
import { books } from '~/data/books';
import { meta, sections, exercisesCount, rozdilyPlanned } from '~/data/popel-himiya-8';

const book = books.find((b) => b.slug === 'popel')!;
const title = 'ГДЗ хімія 8 клас — Попель, Крикля: покроковий розбір';
const description =
  'Розбір завдань підручника «Хімія, 8 клас» П. Попеля, Л. Крикля (Академія, 2025): не просто відповідь, а шлях до неї — що дано, яка формула, чому саме вона, як перевірити. Два режими: «Списати» й «Зрозуміти». Зараз розібрано блок «Стартуємо» (§ 1 – § 3), решта — у роботі.';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: 'Хімія, 8 клас',
    author: { '@type': 'Person', name: meta.author },
    publisher: { '@type': 'Organization', name: meta.publisher },
    datePublished: String(meta.year),
    inLanguage: 'uk',
    image: new URL(book.cover, SITE.url).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    dateModified: meta.updatedAt,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
];
---

<Base title={`${title} | ${SITE.domain}`} {description} type="book" image={book.cover} {jsonLd}>
  <Breadcrumbs
    items={[
      { name: 'Головна', href: '/' },
      { name: '8 клас', href: '/8-klas/popel/' },
      { name: 'Хімія, Попель' },
    ]}
  />

  <BookHero
    title="ГДЗ хімія 8 клас — Попель, Крикля"
    authorFull={meta.author}
    publisher={meta.publisher}
    city={meta.city}
    year={meta.year}
    program={meta.program}
    grif={meta.grif}
    cover={book.cover}
    count={exercisesCount}
    updatedAt={meta.updatedAt}
    mirror={book.mirror}
    description={description}
  />

  <SolutionGallery
    id="himiya8-popel"
    sections={sections}
    storageKey="himiya8-popel"
    checkedNote="Звірено з відповідями підручника (стор. 232)"
  />

  <section class="wrap soon">
    <h2 class="soon__title">Що далі</h2>
    <ul class="soon__list">
      {rozdilyPlanned.map((r) => (
        <li class="soon__item">
          <span class="soon__num">{r.num}</span>
          <span>
            <b>{r.title.replace(/^Розділ\s*\d+\.\s*/, '')}</b>
            <span class="soon__note"> — розв'язання {r.note}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <div class="wrap actions">
    <a class="btn" href="/">Інші книги з хімії</a>
  </div>
</Base>

<style>
  .soon {
    margin-top: 1.6rem;
  }
  .soon__title {
    margin: 0 0 0.6rem;
    font-size: 1.05rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--red);
  }
  .soon__list { margin: 0; padding: 0; list-style: none; display: grid; gap: 0.5rem; }
  .soon__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.8rem;
    border: 2px dashed var(--line);
    border-radius: 10px;
    opacity: 0.85;
  }
  .soon__num {
    flex: 0 0 auto;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--line);
    color: var(--muted);
    font-weight: 800;
  }
  .soon__note { color: var(--muted); }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: center;
    margin-top: 1.6rem;
  }
</style>
